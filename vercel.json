{
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://mongo-shop.vercel.app/api/v1/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/v1/user/sign_out",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ]
}
